# P05 pre-release: use a fresh, disposable PostgreSQL database with pgvector.
# Never point this branch at hosted data or reuse hosted credentials.
# For local development copy to .env.local and supply your isolated database URL.
DATABASE_URL=
# APP_URL=http://localhost:3000
# DATABASE_POOL_MAX=10
# DATABASE_SSL_CA="PEM certificate authority, for verified TLS"
# AI_EMBEDDING_DIMENSIONS=768
# Setup/email sign-in are available. Boot generates and stores their secrets.
# The generated one-time setup code is printed only to the private startup log.
# After claim it is cleared and setup cannot be reopened.
# Optional BETTER_AUTH_SECRET must be an operator-generated random secret.
# Optional SETUP_CODE must encode 32 random bytes as hex or padded base64.
# AI and uploads remain disabled regardless of legacy provider configuration.
# Social sign-in requires an explicitly configured HTTPS APP_URL. Register the
# callback URLs shown in Admin > System at the provider, then restart all replicas.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Single sign-on
# Mail requires resolved APP_URL plus both SMTP values. smtp:// and smtps:// are
# supported; percent-encode reserved characters in credentials. Debug logs are off.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# SMTP_FROM=Feedback <feedback@example.com>
# Enable operator recovery only while recovering access. Generate 32 random bytes
# (64 hex characters or canonical padded base64), keep private and remove this
# variable from EVERY replica after success, then restart them.
# RECOVERY_CODE=
