  "overrides": {
    "jose": "^5.10.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run build -w feedbackland-react && next build",
    "start": "next start",
    "release:react": "npm version patch -w feedbackland-react && npm publish -w feedbackland-react",
    "lint": "next lint",
    "migrate-make": "npx kysely migrate:make -x ts",
    "migrate-up": "npx kysely migrate:up",
    "migrate-down": "npx kysely migrate:down",
    "kysely-codegen": "npx kysely-codegen --dialect postgres --out-file db/schema.ts",
    "schema-dump": "npx supabase db dump -f db/schema.sql",
    "widget-dev": "concurrently -k -n vite,next \"npm run build:watch -w feedbackland-react\" \"next dev --turbopack\""
  },
